{
  "name": "po-genie",
  "version": "0.2.0",
  "description": "AI-powered .po file translator with variable detection",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "po-genie": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "pnpm build && vitest run tests/package-smoke.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm run test",
    "ci:publish": "changeset publish"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^0.4.5",
    "ai": "^4.3.16",
    "citty": "^0.1.6",
    "dotenv": "^16.4.7",
    "gettext-parser": "^8.0.0",
    "std-env": "^3.8.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.8.2",
    "vite": "^6.2.1",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "i18n",
    "l10n",
    "gettext",
    "po",
    "translate",
    "ai",
    "openrouter",
    "wordpress"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/multiplehats/po-genie"
  },
  "homepage": "https://github.com/multiplehats/po-genie#readme",
  "bugs": {
    "url": "https://github.com/multiplehats/po-genie/issues"
  }
}
